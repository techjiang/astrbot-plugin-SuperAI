+@pytest.mark.asyncio
+async def test_file_token_service_reusable_token_can_be_read_repeatedly(tmp_path):
+    """可重复令牌：用于插件图标这类会被前端缓存的静态资源。
+
+    回归：插件图标走一次性令牌时，第一次读取后令牌即失效，
+    于是页面刷新 / 换设备 / 缓存过期后图标变成默认星形（404）。
+    """
+    file_path = tmp_path / "logo.png"
+    file_path.write_bytes(b"PNG")
+
+    service = FileTokenService()
+    token = await service.register_file(str(file_path), timeout=300, reusable=True)
+
+    for _ in range(5):
+        assert await service.handle_file(token) == str(file_path)
+
+
+@pytest.mark.asyncio
+async def test_file_token_service_default_token_is_still_single_use(tmp_path):
+    """默认令牌必须保持「取一次即失效」语义（消息附件依赖它）。"""
+    file_path = tmp_path / "doc.txt"
+    file_path.write_text("doc", encoding="utf-8")
+
+    service = FileTokenService()
+    token = await service.register_file(str(file_path))
+
+    assert await service.handle_file(token) == str(file_path)
+    with pytest.raises(KeyError):
+        await service.handle_file(token)
+
+
+@pytest.mark.asyncio
+async def test_file_token_service_reusable_token_expiry_is_reclaimed(tmp_path):
+    """可重复令牌也会过期，且过期后 reusable 标记要被一并回收（不泄漏内存）。"""
+    file_path = tmp_path / "logo.png"
+    file_path.write_bytes(b"PNG")
+
+    service = FileTokenService()
+    token = await service.register_file(str(file_path), timeout=-1, reusable=True)
+
+    assert await service.check_token_expired(token) is True
+    assert token not in service.reusable_tokens
+    with pytest.raises(KeyError):
+        await service.handle_file(token)
+
+
